            {"arabic": "وَعَمِلُوا", "transliteration": "wa 'amiloo", "meaning": "and done"},
            {"arabic": "الصَّالِحَاتِ", "transliteration": "as-saalihaati", "meaning": "righteous deeds"},
            {"arabic": "وَتَوَاصَوْا", "transliteration": "wa tawasaw", "meaning": "and advised each other"},
            {"arabic": "بِالْحَقِّ", "transliteration": "bil haqq", "meaning": "to truth"},
            {"arabic": "وَتَوَاصَوْا", "transliteration": "wa tawasaw", "meaning": "and advised each other"},
            {"arabic": "بِالصَّبْرِ", "transliteration": "bis sabr", "meaning": "to patience"}
          ]
        }
      ]
    },
    {
      "number": 110,
      "name": "An-Nasr",
      "arabicName": "النصر",
      "meaning": "The Divine Support",
      "totalVerses": 3,
      "revelationType": "Medinan",
      "verses": [
        {
          "number": 1,
          "arabic": "إِذَا جَاءَ نَصْرُ اللَّهِ وَالْفَتْحُ",
          "translation": "When the victory of Allah has come and the conquest,",
          "transliteration": "Iza jaa'a nasrullaahi wal fath",
          "words": [
            {"arabic": "إِذَا", "transliteration": "iza", "meaning": "When"},
            {"arabic": "جَاءَ", "transliteration": "jaa'a", "meaning": "comes"},
            {"arabic": "نَصْرُ", "transliteration": "nasru", "meaning": "the victory / help"},
            {"arabic": "اللَّهِ", "transliteration": "allahi", "meaning": "of Allah"},
            {"arabic": "وَالْفَتْحُ", "transliteration": "wal-fath", "meaning": "and the conquest"}
          ]
        },
        {
          "number": 2,
          "arabic": "وَرَأَيْتَ النَّاسَ يَدْخُلُونَ فِي دِينِ اللَّهِ أَفْوَاجًا",
          "translation": "And you see the people entering into the religion of Allah in multitudes,",
          "transliteration": "Wa ra-aytan naasa yadkhuloona fee deenil laahi afwaaja",
          "words": [
            {"arabic": "وَرَأَيْتَ", "transliteration": "wa ra-ayta", "meaning": "and you see"},
            {"arabic": "النَّاسَ", "transliteration": "an-naasa", "meaning": "the people"},
            {"arabic": "يَدْخُلُونَ", "transliteration": "yadkhuloona", "meaning": "entering"},
            {"arabic": "فِي", "transliteration": "fi", "meaning": "into"},
            {"arabic": "دِينِ", "transliteration": "deeni", "meaning": "the religion"},
            {"arabic": "اللَّهِ", "transliteration": "allahi", "meaning": "of Allah"},
            {"arabic": "أَفْوَاجًا", "transliteration": "afwaaja", "meaning": "in multitudes"}
          ]
        },
        {
          "number": 3,
          "arabic": "فَسَبِّحْ بِحَمْدِ رَبِّكَ وَاسْتَغْفِرْهُ إِنَّهُ كَانَ تَوَّابًا",
          "translation": "Then exalt [Him] with praise of your Lord and ask forgiveness of Him. Indeed, He is ever Accepting of repentance.",
          "transliteration": "Fasabbih bihamdi rabbika wastaghfirh, innahu kaana tawwaaba",
          "words": [
            {"arabic": "فَسَبِّحْ", "transliteration": "fasabbih", "meaning": "Then glorify / exalt"},
            {"arabic": "بِحَمْدِ", "transliteration": "bihamdi", "meaning": "with praise"},
            {"arabic": "رَبِّكَ", "transliteration": "rabbika", "meaning": "of your Lord"},
