{
  "surahs": [
    {
      "number": 1, "name": "Al-Fatiha", "arabicName": "الفاتحة", "meaning": "The Opening", "totalVerses": 7, "revelationType": "Meccan",
      "verses": [
        { "number": 1, "arabic": "بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ", "translation": "In the name of Allah, the Entirely Merciful, the Especially Merciful.", "transliteration": "Bismillahir rahmanir raheem", "words": [{"arabic":"بِسْمِ","transliteration":"bismi","meaning":"In the name"},{"arabic":"اللَّهِ","transliteration":"allahi","meaning":"of Allah"},{"arabic":"الرَّحْمَٰنِ","transliteration":"ar-rahmani","meaning":"the Entirely Merciful"},{"arabic":"الرَّحِيمِ","transliteration":"ar-raheemi","meaning":"the Especially Merciful"}] },
        { "number": 2, "arabic": "الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ", "translation": "All praise is due to Allah, Lord of the worlds.", "transliteration": "Alhamdu lillahi rabbil aalameen", "words": [{"arabic":"الْحَمْدُ","transliteration":"al-hamdu","meaning":"All praise"},{"arabic":"لِلَّهِ","transliteration":"lillahi","meaning":"is for Allah"},{"arabic":"رَبِّ","transliteration":"rabbi","meaning":"Lord"},{"arabic":"الْعَالَمِينَ","transliteration":"al-aalameen","meaning":"of the worlds"}] },
        { "number": 3, "arabic": "الرَّحْمَٰنِ الرَّحِيمِ", "translation": "The Entirely Merciful, the Especially Merciful,", "transliteration": "Ar-rahmanir raheem", "words": [{"arabic":"الرَّحْمَٰنِ","transliteration":"ar-rahmani","meaning":"The Entirely Merciful"},{"arabic":"الرَّحِيمِ","transliteration":"ar-raheemi","meaning":"the Especially Merciful"}] },
        { "number": 4, "arabic": "مَالِكِ يَوْمِ الدِّينِ", "translation": "Sovereign of the Day of Recompense.", "transliteration": "Maliki yawmid deen", "words": [{"arabic":"مَالِكِ","transliteration":"maliki","meaning":"Sovereign"},{"arabic":"يَوْمِ","transliteration":"yawmi","meaning":"of the Day"},{"arabic":"الدِّينِ","transliteration":"ad-deeni","meaning":"of Recompense"}] },
        { "number": 5, "arabic": "إِيَّاكَ نَعْبُدُ وَإِيَّاكَ نَسْتَعِينُ", "translation": "It is You we worship and You we ask for help.", "transliteration": "Iyyaka na'budu wa iyyaka nasta'een", "words": [{"arabic":"إِيَّاكَ","transliteration":"iyyaka","meaning":"You alone"},{"arabic":"نَعْبُدُ","transliteration":"na'budu","meaning":"we worship"},{"arabic":"وَإِيَّاكَ","transliteration":"wa iyyaka","meaning":"and You alone"},{"arabic":"نَسْتَعِينُ","transliteration":"nasta'een","meaning":"we ask for help"}] },
        { "number": 6, "arabic": "اهْدِنَا الصِّرَاطَ الْمُسْتَقِيمَ", "translation": "Guide us to the straight path —", "transliteration": "Ihdinas siratal mustaqeem", "words": [{"arabic":"اهْدِنَا","transliteration":"ihdina","meaning":"Guide us"},{"arabic":"الصِّرَاطَ","transliteration":"as-sirata","meaning":"to the path"},{"arabic":"الْمُسْتَقِيمَ","transliteration":"al-mustaqeem","meaning":"the straight"}] },
        { "number": 7, "arabic": "صِرَاطَ الَّذِينَ أَنْعَمْتَ عَلَيْهِمْ غَيْرِ الْمَغْضُوبِ عَلَيْهِمْ وَلَا الضَّالِّينَ", "translation": "The path of those upon whom You have bestowed favor, not of those who have evoked Your anger or of those who are astray.", "transliteration": "Siratal lazeena an'amta 'alayhim ghayril maghdubi 'alayhim wa lad daaleen", "words": [{"arabic":"صِرَاطَ","transliteration":"sirata","meaning":"The path"},{"arabic":"الَّذِينَ","transliteration":"allazeena","meaning":"of those"},{"arabic":"أَنْعَمْتَ","transliteration":"an'amta","meaning":"You have bestowed favor"},{"arabic":"عَلَيْهِمْ","transliteration":"alayhim","meaning":"upon them"},{"arabic":"غَيْرِ","transliteration":"ghayri","meaning":"not"},{"arabic":"الْمَغْضُوبِ","transliteration":"al-maghdubi","meaning":"those who evoked anger"},{"arabic":"وَلَا","transliteration":"wa la","meaning":"and not"},{"arabic":"الضَّالِّينَ","transliteration":"ad-daalleen","meaning":"those who are astray"}] }
      ]
    },
    {
      "number": 103, "name": "Al-Asr", "arabicName": "العصر", "meaning": "The Declining Day", "totalVerses": 3, "revelationType": "Meccan",
      "verses": [
        { "number": 1, "arabic": "وَالْعَصْرِ", "translation": "By time,", "transliteration": "Wal asr", "words": [{"arabic":"وَالْعَصْرِ","transliteration":"wal-asr","meaning":"By time / the era"}] },
        { "number": 2, "arabic": "إِنَّ الْإِنسَانَ لَفِي خُسْرٍ", "translation": "Indeed, mankind is in loss,", "transliteration": "Innal insaana la fee khusr", "words": [{"arabic":"إِنَّ","transliteration":"inna","meaning":"Indeed"},{"arabic":"الْإِنسَانَ","transliteration":"al-insaana","meaning":"mankind"},{"arabic":"لَفِي","transliteration":"lafi","meaning":"is surely in"},{"arabic":"خُسْرٍ","transliteration":"khusr","meaning":"loss"}] },
        { "number": 3, "arabic": "إِلَّا الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ وَتَوَاصَوْا بِالْحَقِّ وَتَوَاصَوْا بِالصَّبْرِ", "translation": "Except for those who have believed and done righteous deeds and advised each other to truth and advised each other to patience.", "transliteration": "Illal lazeena aamanu wa amiluS saalihaati wa tawasaw bil haqqi wa tawasaw bis sabr", "words": [{"arabic":"إِلَّا","transliteration":"illa","meaning":"Except"},{"arabic":"الَّذِينَ","transliteration":"allazeena","meaning":"those who"},{"arabic":"آمَنُوا","transliteration":"aamanoo","meaning":"have believed"},{"arabic":"وَعَمِلُوا","transliteration":"wa amiloo","meaning":"and done"},{"arabic":"الصَّالِحَاتِ","transliteration":"as-saalihaati","meaning":"righteous deeds"},{"arabic":"وَتَوَاصَوْا","transliteration":"wa tawasaw","meaning":"and advised each other"},{"arabic":"بِالْحَقِّ","transliteration":"bil haqq","meaning":"to truth"},{"arabic":"بِالصَّبْرِ","transliteration":"bis sabr","meaning":"to patience"}] }
      ]
    },
    {
      "number": 108, "name": "Al-Kawthar", "arabicName": "الكوثر", "meaning": "The Abundance", "totalVerses": 3, "revelationType": "Meccan",
      "verses": [
        { "number": 1, "arabic": "إِنَّا أَعْطَيْنَاكَ الْكَوْثَرَ", "translation": "Indeed, We have granted you, [O Muhammad], al-Kawthar.", "transliteration": "Inna a'taynakal kawthar", "words": [{"arabic":"إِنَّا","transliteration":"inna","meaning":"Indeed We"},{"arabic":"أَعْطَيْنَاكَ","transliteration":"a'taynaaka","meaning":"have granted you"},{"arabic":"الْكَوْثَرَ","transliteration":"al-kawthar","meaning":"abundant good"}] },
        { "number": 2, "arabic": "فَصَلِّ لِرَبِّكَ وَانْحَرْ", "translation": "So pray to your Lord and sacrifice [to Him alone].", "transliteration": "Fasalli li rabbika wanhar", "words": [{"arabic":"فَصَلِّ","transliteration":"fasalli","meaning":"So pray"},{"arabic":"لِرَبِّكَ","transliteration":"li rabbika","meaning":"to your Lord"},{"arabic":"وَانْحَرْ","transliteration":"wanhar","meaning":"and sacrifice"}] },
        { "number": 3, "arabic": "إِنَّ شَانِئَكَ هُوَ الْأَبْتَرُ", "translation": "Indeed, your enemy is the one cut off.", "transliteration": "Inna shaani'aka huwal abtar", "words": [{"arabic":"إِنَّ","transliteration":"inna","meaning":"Indeed"},{"arabic":"شَانِئَكَ","transliteration":"shaani'aka","meaning":"your enemy"},{"arabic":"هُوَ","transliteration":"huwa","meaning":"he is"},{"arabic":"الْأَبْتَرُ","transliteration":"al-abtar","meaning":"the one cut off"}] }
      ]
    },
    {
      "number": 110, "name": "An-Nasr", "arabicName": "النصر", "meaning": "The Divine Support", "totalVerses": 3, "revelationType": "Medinan",
      "verses": [
        { "number": 1, "arabic": "إِذَا جَاءَ نَصْرُ اللَّهِ وَالْفَتْحُ", "translation": "When the victory of Allah has come and the conquest,", "transliteration": "Iza jaa'a nasrullaahi wal fath", "words": [{"arabic":"إِذَا","transliteration":"iza","meaning":"When"},{"arabic":"جَاءَ","transliteration":"jaa'a","meaning":"comes"},{"arabic":"نَصْرُ","transliteration":"nasru","meaning":"the victory"},{"arabic":"اللَّهِ","transliteration":"allahi","meaning":"of Allah"},{"arabic":"وَالْفَتْحُ","transliteration":"wal-fath","meaning":"and the conquest"}] },
        { "number": 2, "arabic": "وَرَأَيْتَ النَّاسَ يَدْخُلُونَ فِي دِينِ اللَّهِ أَفْوَاجًا", "translation": "And you see the people entering into the religion of Allah in multitudes,", "transliteration": "Wa ra-aytan naasa yadkhuloona fee deenil laahi afwaaja", "words": [{"arabic":"وَرَأَيْتَ","transliteration":"wa ra-ayta","meaning":"and you see"},{"arabic":"النَّاسَ","transliteration":"an-naasa","meaning":"the people"},{"arabic":"يَدْخُلُونَ","transliteration":"yadkhuloona","meaning":"entering"},{"arabic":"فِي","transliteration":"fi","meaning":"into"},{"arabic":"دِينِ","transliteration":"deeni","meaning":"the religion"},{"arabic":"اللَّهِ","transliteration":"allahi","meaning":"of Allah"},{"arabic":"أَفْوَاجًا","transliteration":"afwaaja","meaning":"in multitudes"}] },
        { "number": 3, "arabic": "فَسَبِّحْ بِحَمْدِ رَبِّكَ وَاسْتَغْفِرْهُ إِنَّهُ كَانَ تَوَّابًا", "translation": "Then exalt Him with praise of your Lord and ask forgiveness of Him. Indeed, He is ever Accepting of repentance.", "transliteration": "Fasabbih bihamdi rabbika wastaghfirh innahu kaana tawwaaba", "words": [{"arabic":"فَسَبِّحْ","transliteration":"fasabbih","meaning":"Then glorify"},{"arabic":"بِحَمْدِ","transliteration":"bihamdi","meaning":"with praise"},{"arabic":"رَبِّكَ","transliteration":"rabbika","meaning":"of your Lord"},{"arabic":"وَاسْتَغْفِرْهُ","transliteration":"wastaghfirh","meaning":"and ask His forgiveness"},{"arabic":"إِنَّهُ","transliteration":"innahu","meaning":"Indeed He"},{"arabic":"كَانَ","transliteration":"kaana","meaning":"is ever"},{"arabic":"تَوَّابًا","transliteration":"tawwaaba","meaning":"Accepting of repentance"}] }
      ]
    },
    {
      "number": 112, "name": "Al-Ikhlas", "arabicName": "الإخلاص", "meaning": "The Sincerity", "totalVerses": 4, "revelationType": "Meccan",
      "verses": [
        { "number": 1, "arabic": "قُلْ هُوَ اللَّهُ أَحَدٌ", "translation": "Say, He is Allah, [who is] One,", "transliteration": "Qul huwal laahu ahad", "words": [{"arabic":"قُلْ","transliteration":"qul","meaning":"Say"},{"arabic":"هُوَ","transliteration":"huwa","meaning":"He is"},{"arabic":"اللَّهُ","transliteration":"allahu","meaning":"Allah"},{"arabic":"أَحَدٌ","transliteration":"ahad","meaning":"One"}] },
        { "number": 2, "arabic": "اللَّهُ الصَّمَدُ", "translation": "Allah, the Eternal Refuge.", "transliteration": "Allahus samad", "words": [{"arabic":"اللَّهُ","transliteration":"allahu","meaning":"Allah"},{"arabic":"الصَّمَدُ","transliteration":"as-samad","meaning":"the Eternal Refuge"}] },
        { "number": 3, "arabic": "لَمْ يَلِدْ وَلَمْ يُولَدْ", "translation": "He neither begets nor is born,", "transliteration": "Lam yalid wa lam yoolad", "words": [{"arabic":"لَمْ","transliteration":"lam","meaning":"He did not"},{"arabic":"يَلِدْ","transliteration":"yalid","meaning":"beget"},{"arabic":"وَلَمْ","transliteration":"wa lam","meaning":"and never"},{"arabic":"يُولَدْ","transliteration":"yoolad","meaning":"was born"}] },
        { "number": 4, "arabic": "وَلَمْ يَكُن لَّهُ كُفُوًا أَحَدٌ", "translation": "Nor is there to Him any equivalent.", "transliteration": "Wa lam yakul lahoo kufuwan ahad", "words": [{"arabic":"وَلَمْ","transliteration":"wa lam","meaning":"and there is not"},{"arabic":"يَكُن","transliteration":"yakun","meaning":"equal"},{"arabic":"لَّهُ","transliteration":"lahu","meaning":"to Him"},{"arabic":"كُفُوًا","transliteration":"kufuwan","meaning":"any equivalent"},{"arabic":"أَحَدٌ","transliteration":"ahad","meaning":"anyone"}] }
      ]
    },
    {
      "number": 106, "name": "Quraysh", "arabicName": "قريش", "meaning": "Quraysh", "totalVerses": 4, "revelationType": "Meccan",
      "verses": [
        { "number": 1, "arabic": "لِإِيلَافِ قُرَيْشٍ", "translation": "For the accustomed security of the Quraysh —", "transliteration": "Li-eelaafi quraish", "words": [{"arabic":"لِإِيلَافِ","transliteration":"li-eelaafi","meaning":"For the accustomed security"},{"arabic":"قُرَيْشٍ","transliteration":"quraish","meaning":"of Quraysh"}] },
        { "number": 2, "arabic": "إِيلَافِهِمْ رِحْلَةَ الشِّتَاءِ وَالصَّيْفِ", "translation": "Their accustomed security [in] the caravan of winter and summer —", "transliteration": "Eelaafihim rihlatas shitaa-i was saif", "words": [{"arabic":"إِيلَافِهِمْ","transliteration":"eelaafihim","meaning":"Their security"},{"arabic":"رِحْلَةَ","transliteration":"rihlata","meaning":"the journey / caravan"},{"arabic":"الشِّتَاءِ","transliteration":"ash-shitaa-i","meaning":"of winter"},{"arabic":"وَالصَّيْفِ","transliteration":"was-saif","meaning":"and summer"}] },
        { "number": 3, "arabic": "فَلْيَعْبُدُوا رَبَّ هَٰذَا الْبَيْتِ", "translation": "Let them worship the Lord of this House,", "transliteration": "Falya'budoo rabba haazal bait", "words": [{"arabic":"فَلْيَعْبُدُوا","transliteration":"falya'budoo","meaning":"Let them worship"},{"arabic":"رَبَّ","transliteration":"rabba","meaning":"the Lord"},{"arabic":"هَٰذَا","transliteration":"haaza","meaning":"of this"},{"arabic":"الْبَيْتِ","transliteration":"al-bait","meaning":"House"}] },
        { "number": 4, "arabic": "الَّذِي أَطْعَمَهُم مِّن جُوعٍ وَآمَنَهُم مِّنْ خَوْفٍ", "translation": "Who has fed them, [saving them] from hunger and made them safe, [saving them] from fear.", "transliteration": "Allazi at'amahum min joo'in wa aamanahum min khawf", "words": [{"arabic":"الَّذِي","transliteration":"allazi","meaning":"Who"},{"arabic":"أَطْعَمَهُم","transliteration":"at'amahum","meaning":"has fed them"},{"arabic":"مِّن جُوعٍ","transliteration":"min joo'","meaning":"from hunger"},{"arabic":"وَآمَنَهُم","transliteration":"wa aamanahum","meaning":"and made them safe"},{"arabic":"مِّنْ خَوْفٍ","transliteration":"min khawf","meaning":"from fear"}] }
      ]
    },
    {
      "number": 111, "name": "Al-Masad", "arabicName": "المسد", "meaning": "The Palm Fiber", "totalVerses": 5, "revelationType": "Meccan",
      "verses": [
        { "number": 1, "arabic": "تَبَّتْ يَدَا أَبِي لَهَبٍ وَتَبَّ", "translation": "May the hands of Abu Lahab be ruined, and ruined is he.", "transliteration": "Tabbat yadaa abi lahabiw wa tabb", "words": [{"arabic":"تَبَّتْ","transliteration":"tabbat","meaning":"May be ruined"},{"arabic":"يَدَا","transliteration":"yadaa","meaning":"the hands"},{"arabic":"أَبِي لَهَبٍ","transliteration":"abi lahab","meaning":"of Abu Lahab"},{"arabic":"وَتَبَّ","transliteration":"wa tabb","meaning":"and ruined is he"}] },
        { "number": 2, "arabic": "مَا أَغْنَىٰ عَنْهُ مَالُهُ وَمَا كَسَبَ", "translation": "His wealth will not avail him or that which he gained.", "transliteration": "Maa aghna 'anhu maaluhu wa maa kasab", "words": [{"arabic":"مَا","transliteration":"maa","meaning":"will not"},{"arabic":"أَغْنَىٰ","transliteration":"aghna","meaning":"avail"},{"arabic":"عَنْهُ","transliteration":"anhu","meaning":"him"},{"arabic":"مَالُهُ","transliteration":"maaluhu","meaning":"his wealth"},{"arabic":"وَمَا كَسَبَ","transliteration":"wa maa kasab","meaning":"or that which he gained"}] },
        { "number": 3, "arabic": "سَيَصْلَىٰ نَارًا ذَاتَ لَهَبٍ", "translation": "He will [soon] enter a Fire of blazing flame", "transliteration": "Sayasla naaran zaata lahab", "words": [{"arabic":"سَيَصْلَىٰ","transliteration":"sayasla","meaning":"He will enter"},{"arabic":"نَارًا","transliteration":"naaran","meaning":"a Fire"},{"arabic":"ذَاتَ","transliteration":"zaata","meaning":"of blazing"},{"arabic":"لَهَبٍ","transliteration":"lahab","meaning":"flame"}] },
        { "number": 4, "arabic": "وَامْرَأَتُهُ حَمَّالَةَ الْحَطَبِ", "translation": "And his wife [as well] — the carrier of firewood.", "transliteration": "Wamra-atuhu hammaalatal hatab", "words": [{"arabic":"وَامْرَأَتُهُ","transliteration":"wamra-atuhu","meaning":"And his wife"},{"arabic":"حَمَّالَةَ","transliteration":"hammaala","meaning":"the carrier"},{"arabic":"الْحَطَبِ","transliteration":"al-hatab","meaning":"of firewood"}] },
        { "number": 5, "arabic": "فِي جِيدِهَا حَبْلٌ مِّن مَّسَدٍ", "translation": "Around her neck is a rope of [twisted] fiber.", "transliteration": "Fee jeedihaa hablum mim masad", "words": [{"arabic":"فِي","transliteration":"fi","meaning":"Around"},{"arabic":"جِيدِهَا","transliteration":"jeedihaa","meaning":"her neck"},{"arabic":"حَبْلٌ","transliteration":"hablun","meaning":"a rope"},{"arabic":"مِّن مَّسَدٍ","transliteration":"mim masad","meaning":"of twisted fiber"}] }
      ]
    },
    {
      "number": 105, "name": "Al-Fil", "arabicName": "الفيل", "meaning": "The Elephant", "totalVerses": 5, "revelationType": "Meccan",
      "verses": [
        { "number": 1, "arabic": "أَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِأَصْحَابِ الْفِيلِ", "translation": "Have you not considered, [O Muhammad], how your Lord dealt with the companions of the elephant?", "transliteration": "Alam tara kayfa fa'ala rabbuka bi-as-haabil feel", "words": [{"arabic":"أَلَمْ تَرَ","transliteration":"alam tara","meaning":"Have you not seen"},{"arabic":"كَيْفَ","transliteration":"kayfa","meaning":"how"},{"arabic":"فَعَلَ","transliteration":"fa'ala","meaning":"dealt"},{"arabic":"رَبُّكَ","transliteration":"rabbuka","meaning":"your Lord"},{"arabic":"بِأَصْحَابِ","transliteration":"bi-as-haab","meaning":"with the companions"},{"arabic":"الْفِيلِ","transliteration":"al-feel","meaning":"of the elephant"}] },
        { "number": 2, "arabic": "أَلَمْ يَجْعَلْ كَيْدَهُمْ فِي تَضْلِيلٍ", "translation": "Did He not make their plan into misguidance?", "transliteration": "Alam yaj'al kaydahum fee tadleel", "words": [{"arabic":"أَلَمْ يَجْعَلْ","transliteration":"alam yaj'al","meaning":"Did He not make"},{"arabic":"كَيْدَهُمْ","transliteration":"kaydahum","meaning":"their plan"},{"arabic":"فِي","transliteration":"fi","meaning":"into"},{"arabic":"تَضْلِيلٍ","transliteration":"tadleel","meaning":"misguidance / failure"}] },
        { "number": 3, "arabic": "وَأَرْسَلَ عَلَيْهِمْ طَيْرًا أَبَابِيلَ", "translation": "And He sent against them birds in flocks,", "transliteration": "Wa arsala 'alayhim tayran abaabeel", "words": [{"arabic":"وَأَرْسَلَ","transliteration":"wa arsala","meaning":"And He sent"},{"arabic":"عَلَيْهِمْ","transliteration":"alayhim","meaning":"against them"},{"arabic":"طَيْرًا","transliteration":"tayran","meaning":"birds"},{"arabic":"أَبَابِيلَ","transliteration":"abaabeel","meaning":"in flocks"}] },
        { "number": 4, "arabic": "تَرْمِيهِم بِحِجَارَةٍ مِّن سِجِّيلٍ", "translation": "Striking them with stones of hard clay,", "transliteration": "Tarmeehim bihijaaratim min sijjeel", "words": [{"arabic":"تَرْمِيهِم","transliteration":"tarmeehim","meaning":"Striking them"},{"arabic":"بِحِجَارَةٍ","transliteration":"bihijaara","meaning":"with stones"},{"arabic":"مِّن","transliteration":"min","meaning":"of"},{"arabic":"سِجِّيلٍ","transliteration":"sijjeel","meaning":"hard clay"}] },
        { "number": 5, "arabic": "فَجَعَلَهُمْ كَعَصْفٍ مَّأْكُولٍ", "translation": "And He made them like eaten straw.", "transliteration": "Faja'alahum ka'asfim ma'kool", "words": [{"arabic":"فَجَعَلَهُمْ","transliteration":"faja'alahum","meaning":"And He made them"},{"arabic":"كَعَصْفٍ","transliteration":"ka'asf","meaning":"like straw"},{"arabic":"مَّأْكُولٍ","transliteration":"ma'kool","meaning":"eaten"}] }
      ]
    },
    {
      "number": 107, "name": "Al-Ma'un", "arabicName": "الماعون", "meaning": "The Small Kindnesses", "totalVerses": 7, "revelationType": "Meccan",
      "verses": [
        { "number": 1, "arabic": "أَرَأَيْتَ الَّذِي يُكَذِّبُ بِالدِّينِ", "translation": "Have you seen the one who denies the Recompense?", "transliteration": "Ara-aytal lazee yukazzibu bid-deen", "words": [{"arabic":"أَرَأَيْتَ","transliteration":"ara-ayta","meaning":"Have you seen"},{"arabic":"الَّذِي","transliteration":"allazi","meaning":"the one who"},{"arabic":"يُكَذِّبُ","transliteration":"yukaz-zibu","meaning":"denies"},{"arabic":"بِالدِّينِ","transliteration":"bid-deen","meaning":"the Recompense"}] },
        { "number": 2, "arabic": "فَذَٰلِكَ الَّذِي يَدُعُّ الْيَتِيمَ", "translation": "For that is the one who drives away the orphan", "transliteration": "Fazaalikal lazee yadu'ul yateem", "words": [{"arabic":"فَذَٰلِكَ","transliteration":"fazaalika","meaning":"For that"},{"arabic":"الَّذِي","transliteration":"allazi","meaning":"is the one who"},{"arabic":"يَدُعُّ","transliteration":"yadu'u","meaning":"drives away"},{"arabic":"الْيَتِيمَ","transliteration":"al-yateem","meaning":"the orphan"}] },
        { "number": 3, "arabic": "وَلَا يَحُضُّ عَلَىٰ طَعَامِ الْمِسْكِينِ", "translation": "And does not encourage the feeding of the poor.", "transliteration": "Wa laa yahuddu 'alaa ta'aamil miskeen", "words": [{"arabic":"وَلَا","transliteration":"wa laa","meaning":"And does not"},{"arabic":"يَحُضُّ","transliteration":"yahuddu","meaning":"encourage"},{"arabic":"عَلَىٰ","transliteration":"alaa","meaning":"toward"},{"arabic":"طَعَامِ","transliteration":"ta'aam","meaning":"the feeding"},{"arabic":"الْمِسْكِينِ","transliteration":"al-miskeen","meaning":"of the poor"}] },
        { "number": 4, "arabic": "فَوَيْلٌ لِّلْمُصَلِّينَ", "translation": "So woe to those who pray", "transliteration": "Fawaylul lil musalleen", "words": [{"arabic":"فَوَيْلٌ","transliteration":"fawaylun","meaning":"So woe"},{"arabic":"لِّلْمُصَلِّينَ","transliteration":"lil-musalleen","meaning":"to those who pray"}] },
        { "number": 5, "arabic": "الَّذِينَ هُمْ عَن صَلَاتِهِمْ سَاهُونَ", "translation": "[But] who are heedless of their prayer —", "transliteration": "Allazeena hum 'an salaatihim saahoon", "words": [{"arabic":"الَّذِينَ","transliteration":"allazeena","meaning":"Those who"},{"arabic":"هُمْ","transliteration":"hum","meaning":"are"},{"arabic":"عَن","transliteration":"an","meaning":"about"},{"arabic":"صَلَاتِهِمْ","transliteration":"salaatihim","meaning":"their prayer"},{"arabic":"سَاهُونَ","transliteration":"saahoon","meaning":"heedless"}] },
        { "number": 6, "arabic": "الَّذِينَ هُمْ يُرَاءُونَ", "translation": "Those who make show [of their deeds]", "transliteration": "Allazeena hum yuraa'oon", "words": [{"arabic":"الَّذِينَ","transliteration":"allazeena","meaning":"Those who"},{"arabic":"هُمْ","transliteration":"hum","meaning":"are"},{"arabic":"يُرَاءُونَ","transliteration":"yuraa'oon","meaning":"showing off"}] },
        { "number": 7, "arabic": "وَيَمْنَعُونَ الْمَاعُونَ", "translation": "And withhold [simple] assistance.", "transliteration": "Wa yamna'oonil maa'oon", "words": [{"arabic":"وَيَمْنَعُونَ","transliteration":"wa yamna'oon","meaning":"And withhold"},{"arabic":"الْمَاعُونَ","transliteration":"al-maa'oon","meaning":"small kindnesses / assistance"}] }
      ]
    },
    {
      "number": 94, "name": "Ash-Sharh", "arabicName": "الشرح", "meaning": "The Relief", "totalVerses": 8, "revelationType": "Meccan",
      "verses": [
        { "number": 1, "arabic": "أَلَمْ نَشْرَحْ لَكَ صَدْرَكَ", "translation": "Did We not expand for you, [O Muhammad], your breast?", "transliteration": "Alam nashrah laka sadrak", "words": [{"arabic":"أَلَمْ","transliteration":"alam","meaning":"Did We not"},{"arabic":"نَشْرَحْ","transliteration":"nashrah","meaning":"expand"},{"arabic":"لَكَ","transliteration":"laka","meaning":"for you"},{"arabic":"صَدْرَكَ","transliteration":"sadrak","meaning":"your breast / heart"}] },
        { "number": 2, "arabic": "وَوَضَعْنَا عَنكَ وِزْرَكَ", "translation": "And We removed from you your burden", "transliteration": "Wa wada'naa anka wizrak", "words": [{"arabic":"وَوَضَعْنَا","transliteration":"wa wada'naa","meaning":"And We removed"},{"arabic":"عَنكَ","transliteration":"anka","meaning":"from you"},{"arabic":"وِزْرَكَ","transliteration":"wizrak","meaning":"your burden"}] },
        { "number": 3, "arabic": "الَّذِي أَنقَضَ ظَهْرَكَ", "translation": "Which had weighed upon your back", "transliteration": "Allazi anqada zahrak", "words": [{"arabic":"الَّذِي","transliteration":"allazi","meaning":"Which"},{"arabic":"أَنقَضَ","transliteration":"anqada","meaning":"had weighed upon"},{"arabic":"ظَهْرَكَ","transliteration":"zahrak","meaning":"your back"}] },
        { "number": 4, "arabic": "وَرَفَعْنَا لَكَ ذِكْرَكَ", "translation": "And raised high for you your repute.", "transliteration": "Wa rafa'naa laka zikrak", "words": [{"arabic":"وَرَفَعْنَا","transliteration":"wa rafa'naa","meaning":"And We raised high"},{"arabic":"لَكَ","transliteration":"laka","meaning":"for you"},{"arabic":"ذِكْرَكَ","transliteration":"zikrak","meaning":"your repute / mention"}] },
        { "number": 5, "arabic": "فَإِنَّ مَعَ الْعُسْرِ يُسْرًا", "translation": "For indeed, with hardship [will be] ease.", "transliteration": "Fa-inna ma'al 'usri yusraa", "words": [{"arabic":"فَإِنَّ","transliteration":"fa-inna","meaning":"For indeed"},{"arabic":"مَعَ","transliteration":"ma'a","meaning":"with"},{"arabic":"الْعُسْرِ","transliteration":"al-'usri","meaning":"hardship"},{"arabic":"يُسْرًا","transliteration":"yusraa","meaning":"ease"}] },
        { "number": 6, "arabic": "إِنَّ مَعَ الْعُسْرِ يُسْرًا", "translation": "Indeed, with hardship [will be] ease.", "transliteration": "Inna ma'al 'usri yusraa", "words": [{"arabic":"إِنَّ","transliteration":"inna","meaning":"Indeed"},{"arabic":"مَعَ","transliteration":"ma'a","meaning":"with"},{"arabic":"الْعُسْرِ","transliteration":"al-'usri","meaning":"hardship"},{"arabic":"يُسْرًا","transliteration":"yusraa","meaning":"ease"}] },
        { "number": 7, "arabic": "فَإِذَا فَرَغْتَ فَانصَبْ", "translation": "So when you have finished [your duties], then stand up [for worship].", "transliteration": "Fa-iza faraghta fansab", "words": [{"arabic":"فَإِذَا","transliteration":"fa-iza","meaning":"So when"},{"arabic":"فَرَغْتَ","transliteration":"faraghta","meaning":"you have finished"},{"arabic":"فَانصَبْ","transliteration":"fansab","meaning":"stand up / strive"}] },
        { "number": 8, "arabic": "وَإِلَىٰ رَبِّكَ فَارْغَبْ", "translation": "And to your Lord direct [your] longing.", "transliteration": "Wa ilaa rabbika farghab", "words": [{"arabic":"وَإِلَىٰ","transliteration":"wa ilaa","meaning":"And toward"},{"arabic":"رَبِّكَ","transliteration":"rabbika","meaning":"your Lord"},{"arabic":"فَارْغَبْ","transliteration":"farghab","meaning":"direct your longing"}] }
      ]
    },
    {
      "number": 93, "name": "Ad-Duha", "arabicName": "الضحى", "meaning": "The Morning Hours", "totalVerses": 11, "revelationType": "Meccan",
      "verses": [
        { "number": 1, "arabic": "وَالضُّحَىٰ", "translation": "By the morning brightness", "transliteration": "Wad-duhaa", "words": [{"arabic":"وَالضُّحَىٰ","transliteration":"wad-duhaa","meaning":"By the morning brightness"}] },
        { "number": 2, "arabic": "وَاللَّيْلِ إِذَا سَجَىٰ", "translation": "And [by] the night when it covers with darkness,", "transliteration": "Wallayli iza sajaa", "words": [{"arabic":"وَاللَّيْلِ","transliteration":"wallayli","meaning":"And by the night"},{"arabic":"إِذَا","transliteration":"iza","meaning":"when"},{"arabic":"سَجَىٰ","transliteration":"sajaa","meaning":"it settles / covers"}] },
        { "number": 3, "arabic": "مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ", "translation": "Your Lord has not taken leave of you, [O Muhammad], nor has He detested [you].", "transliteration": "Maa wadda'aka rabbuka wa maa qalaa", "words": [{"arabic":"مَا","transliteration":"maa","meaning":"has not"},{"arabic":"وَدَّعَكَ","transliteration":"wadda'aka","meaning":"taken leave of you"},{"arabic":"رَبُّكَ","transliteration":"rabbuka","meaning":"your Lord"},{"arabic":"وَمَا","transliteration":"wa maa","meaning":"nor"},{"arabic":"قَلَىٰ","transliteration":"qalaa","meaning":"detested you"}] },
        { "number": 4, "arabic": "وَلَلْآخِرَةُ خَيْرٌ لَّكَ مِنَ الْأُولَىٰ", "translation": "And the Hereafter is better for you than the first [life].", "transliteration": "Walal-aakhiratu khayrul laka minal-oolaa", "words": [{"arabic":"وَلَلْآخِرَةُ","transliteration":"walal-akhira","meaning":"And the Hereafter"},{"arabic":"خَيْرٌ","transliteration":"khayr","meaning":"is better"},{"arabic":"لَّكَ","transliteration":"laka","meaning":"for you"},{"arabic":"مِنَ","transliteration":"mina","meaning":"than"},{"arabic":"الْأُولَىٰ","transliteration":"al-oolaa","meaning":"the first life"}] },
        { "number": 5, "arabic": "وَلَسَوْفَ يُعْطِيكَ رَبُّكَ فَتَرْضَىٰ", "translation": "And your Lord is going to give you, and you will be satisfied.", "transliteration": "Wa lasawfa yu'teeka rabbuka fatardaa", "words": [{"arabic":"وَلَسَوْفَ","transliteration":"wa lasawfa","meaning":"And your Lord will surely"},{"arabic":"يُعْطِيكَ","transliteration":"yu'teeka","meaning":"give you"},{"arabic":"رَبُّكَ","transliteration":"rabbuka","meaning":"your Lord"},{"arabic":"فَتَرْضَىٰ","transliteration":"fatardaa","meaning":"and you will be satisfied"}] },
        { "number": 6, "arabic": "أَلَمْ يَجِدْكَ يَتِيمًا فَآوَىٰ", "translation": "Did He not find you an orphan and give [you] refuge?", "transliteration": "Alam yajidka yateeman fa-aawaa", "words": [{"arabic":"أَلَمْ","transliteration":"alam","meaning":"Did He not"},{"arabic":"يَجِدْكَ","transliteration":"yajidka","meaning":"find you"},{"arabic":"يَتِيمًا","transliteration":"yateeman","meaning":"an orphan"},{"arabic":"فَآوَىٰ","transliteration":"fa-aawaa","meaning":"and give refuge"}] },
        { "number": 7, "arabic": "وَوَجَدَكَ ضَالًّا فَهَدَىٰ", "translation": "And He found you lost and guided [you],", "transliteration": "Wa wajadaka daaallan fahadaa", "words": [{"arabic":"وَوَجَدَكَ","transliteration":"wa wajadaka","meaning":"And He found you"},{"arabic":"ضَالًّا","transliteration":"daaallan","meaning":"lost"},{"arabic":"فَهَدَىٰ","transliteration":"fahadaa","meaning":"and guided you"}] },
        { "number": 8, "arabic": "وَوَجَدَكَ عَائِلًا فَأَغْنَىٰ", "translation": "And He found you poor and made [you] self-sufficient.", "transliteration": "Wa wajadaka 'aa'ilan fa-aghnaa", "words": [{"arabic":"وَوَجَدَكَ","transliteration":"wa wajadaka","meaning":"And He found you"},{"arabic":"عَائِلًا","transliteration":"aa'ilan","meaning":"poor"},{"arabic":"فَأَغْنَىٰ","transliteration":"fa-aghnaa","meaning":"and made you self-sufficient"}] },
        { "number": 9, "arabic": "فَأَمَّا الْيَتِيمَ فَلَا تَقْهَرْ", "translation": "So as for the orphan, do not oppress [him].", "transliteration": "Fa-ammal yateema falaa taqhar", "words": [{"arabic":"فَأَمَّا","transliteration":"fa-ammaa","meaning":"So as for"},{"arabic":"الْيَتِيمَ","transliteration":"al-yateem","meaning":"the orphan"},{"arabic":"فَلَا تَقْهَرْ","transliteration":"falaa taqhar","meaning":"do not oppress"}] },
        { "number": 10, "arabic": "وَأَمَّا السَّائِلَ فَلَا تَنْهَرْ", "translation": "And as for the petitioner, do not repel [him].", "transliteration": "Wa ammas saa-ila falaa tanhar", "words": [{"arabic":"وَأَمَّا","transliteration":"wa ammaa","meaning":"And as for"},{"arabic":"السَّائِلَ","transliteration":"as-saa'il","meaning":"the petitioner / beggar"},{"arabic":"فَلَا تَنْهَرْ","transliteration":"falaa tanhar","meaning":"do not repel"}] },
        { "number": 11, "arabic": "وَأَمَّا بِنِعْمَةِ رَبِّكَ فَحَدِّثْ", "translation": "But as for the favor of your Lord, report [it].", "transliteration": "Wa ammaa bini'mati rabbika fahaddith", "words": [{"arabic":"وَأَمَّا","transliteration":"wa ammaa","meaning":"But as for"},{"arabic":"بِنِعْمَةِ","transliteration":"bini'mati","meaning":"the favor"},{"arabic":"رَبِّكَ","transliteration":"rabbika","meaning":"of your Lord"},{"arabic":"فَحَدِّثْ","transliteration":"fahaddith","meaning":"report / proclaim it"}] }
      ]
    },
    {
      "number": 97, "name": "Al-Qadr", "arabicName": "القدر", "meaning": "The Power", "totalVerses": 5, "revelationType": "Meccan",
      "verses": [
        { "number": 1, "arabic": "إِنَّا أَنزَلْنَاهُ فِي لَيْلَةِ الْقَدْرِ", "translation": "Indeed, We sent the Quran down during the Night of Decree.", "transliteration": "Inna anzalnaahu fi laylatal qadr", "words": [{"arabic":"إِنَّا","transliteration":"inna","meaning":"Indeed We"},{"arabic":"أَنزَلْنَاهُ","transliteration":"anzalnahu","meaning":"sent it down"},{"arabic":"فِي","transliteration":"fi","meaning":"in"},{"arabic":"لَيْلَةِ","transliteration":"laylati","meaning":"the night"},{"arabic":"الْقَدْرِ","transliteration":"al-qadr","meaning":"of Power / Decree"}] },
        { "number": 2, "arabic": "وَمَا أَدْرَاكَ مَا لَيْلَةُ الْقَدْرِ", "translation": "And what can make you know what is the Night of Decree?", "transliteration": "Wa maa adraaka maa laylatul qadr", "words": [{"arabic":"وَمَا","transliteration":"wa maa","meaning":"And what"},{"arabic":"أَدْرَاكَ","transliteration":"adraaka","meaning":"can make you know"},{"arabic":"مَا","transliteration":"maa","meaning":"what is"},{"arabic":"لَيْلَةُ","transliteration":"laylatu","meaning":"the night"},{"arabic":"الْقَدْرِ","transliteration":"al-qadr","meaning":"of Power"}] },
        { "number": 3, "arabic": "لَيْلَةُ الْقَدْرِ خَيْرٌ مِّنْ أَلْفِ شَهْرٍ", "translation": "The Night of Decree is better than a thousand months.", "transliteration": "Laylatul qadri khayrum min alfi shahr", "words": [{"arabic":"لَيْلَةُ","transliteration":"laylatu","meaning":"The Night"},{"arabic":"الْقَدْرِ","transliteration":"al-qadr","meaning":"of Power"},{"arabic":"خَيْرٌ","transliteration":"khayr","meaning":"is better"},{"arabic":"مِّنْ","transliteration":"min","meaning":"than"},{"arabic":"أَلْفِ","transliteration":"alfi","meaning":"a thousand"},{"arabic":"شَهْرٍ","transliteration":"shahr","meaning":"months"}] },
        { "number": 4, "arabic": "تَنَزَّلُ الْمَلَائِكَةُ وَالرُّوحُ فِيهَا بِإِذْنِ رَبِّهِم مِّن كُلِّ أَمْرٍ", "translation": "The angels and the Spirit descend therein by permission of their Lord for every matter.", "transliteration": "Tanazzalul malaa-ikatu war roohu feehaa bi-izni rabbihim min kulli amr", "words": [{"arabic":"تَنَزَّلُ","transliteration":"tanazzalu","meaning":"descend"},{"arabic":"الْمَلَائِكَةُ","transliteration":"al-malaa'ikatu","meaning":"the angels"},{"arabic":"وَالرُّوحُ","transliteration":"war-roohu","meaning":"and the Spirit"},{"arabic":"فِيهَا","transliteration":"feeha","meaning":"therein"},{"arabic":"بِإِذْنِ","transliteration":"bi-izni","meaning":"by permission"},{"arabic":"رَبِّهِم","transliteration":"rabbihim","meaning":"of their Lord"},{"arabic":"مِّن كُلِّ أَمْرٍ","transliteration":"min kulli amr","meaning":"for every matter"}] },
        { "number": 5, "arabic": "سَلَامٌ هِيَ حَتَّىٰ مَطْلَعِ الْفَجْرِ", "translation": "Peace it is until the emergence of dawn.", "transliteration": "Salaamun hiya hattaa mat la'il fajr", "words": [{"arabic":"سَلَامٌ","transliteration":"salaam","meaning":"Peace"},{"arabic":"هِيَ","transliteration":"hiya","meaning":"it is"},{"arabic":"حَتَّىٰ","transliteration":"hatta","meaning":"until"},{"arabic":"مَطْلَعِ","transliteration":"mat la'i","meaning":"the emergence"},{"arabic":"الْفَجْرِ","transliteration":"al-fajr","meaning":"of dawn"}] }
      ]
    },
    {
      "number": 109, "name": "Al-Kafirun", "arabicName": "الكافرون", "meaning": "The Disbelievers", "totalVerses": 6, "revelationType": "Meccan",
      "verses": [
        { "number": 1, "arabic": "قُلْ يَا أَيُّهَا الْكَافِرُونَ", "translation": "Say, O disbelievers,", "transliteration": "Qul yaa ayyuhal kaafiroon", "words": [{"arabic":"قُلْ","transliteration":"qul","meaning":"Say"},{"arabic":"يَا أَيُّهَا","transliteration":"yaa ayyuha","meaning":"O"},{"arabic":"الْكَافِرُونَ","transliteration":"al-kaafiroon","meaning":"the disbelievers"}] },
        { "number": 2, "arabic": "لَا أَعْبُدُ مَا تَعْبُدُونَ", "translation": "I do not worship what you worship.", "transliteration": "Laa a'budu maa ta'budoon", "words": [{"arabic":"لَا","transliteration":"laa","meaning":"I do not"},{"arabic":"أَعْبُدُ","transliteration":"a'budu","meaning":"worship"},{"arabic":"مَا","transliteration":"maa","meaning":"what"},{"arabic":"تَعْبُدُونَ","transliteration":"ta'budoon","meaning":"you worship"}] },
        { "number": 3, "arabic": "وَلَا أَنتُمْ عَابِدُونَ مَا أَعْبُدُ", "translation": "Nor are you worshippers of what I worship.", "transliteration": "Wa laa antum 'aabidoona maa a'bud", "words": [{"arabic":"وَلَا","transliteration":"wa laa","meaning":"Nor are"},{"arabic":"أَنتُمْ","transliteration":"antum","meaning":"you"},{"arabic":"عَابِدُونَ","transliteration":"'aabidoon","meaning":"worshippers"},{"arabic":"مَا أَعْبُدُ","transliteration":"maa a'bud","meaning":"of what I worship"}] },
