    {
      "number": 103,
      "name": "Al-Asr",
      "arabicName": "العصر",
      "meaning": "The Declining Day",
      "totalVerses": 3,
      "revelationType": "Meccan",
      "verses": [
        {
          "number": 1,
          "arabic": "وَالْعَصْرِ",
          "translation": "By time,",
          "transliteration": "Wal 'asr",
          "words": [
