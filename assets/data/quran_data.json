        },
        {
          "number": 3,
          "arabic": "وَمِن شَرِّ غَاسِقٍ إِذَا وَقَبَ",
          "translation": "And from the evil of darkness when it settles",
          "transliteration": "Wa min sharri ghaasiqin iza waqab",
          "words": [
            {"arabic": "وَمِن", "transliteration": "wa min", "meaning": "and from"},
            {"arabic": "شَرِّ", "transliteration": "sharri", "meaning": "the evil"},
            {"arabic": "غَاسِقٍ", "transliteration": "ghaasiq", "meaning": "of darkness"},
            {"arabic": "إِذَا", "transliteration": "iza", "meaning": "when"},
            {"arabic": "وَقَبَ", "transliteration": "waqab", "meaning": "it settles / overcomes"}
